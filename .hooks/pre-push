#!/usr/bin/env zsh
# pre-push: kebab-slug tree; auto-commit if mutated; warn repo size.

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

SLUG="$ROOT/.hooks/scripts/sluggify-paths.sh"
[[ -x "$SLUG" ]] && "$SLUG" --tree "$ROOT" || true

if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
  git add -A
  if ! git diff --cached --quiet; then
    git commit -m "chore: sluggify paths (hook)" || true
    echo "[pre-push] sluggify committed; re-run push" >&2
    exit 1
  fi
fi

CHECK_SCRIPT="${ROOT}/bin/check-repo-size.sh"
[[ -x "${CHECK_SCRIPT}" ]] && "${CHECK_SCRIPT}" || true

exit 0
