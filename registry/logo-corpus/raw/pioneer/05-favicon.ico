<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Paint the saved theme before the module bundle. SettingsProvider
       applies the same `app-theme` rules after React mounts; until that
       effect runs, the browser canvas is white. Colours match --background
       in src/styles/theme.css (light oklch(1 0 0), dark oklch(0.145 0 0)). -->
  <script id="theme-boot">
    (function () {
      var theme;
      try {
        theme = localStorage.getItem('app-theme');
      } catch (e) {
        return;
      }
      var dark = theme === 'dark';
      if (!dark && theme === 'system') {
        try {
          dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        } catch (e) {
          dark = false;
        }
      }
      if (dark) document.documentElement.classList.add('dark');
    })();
  </script>
  <style id="theme-canvas">
    html { background-color: #fff; background-color: oklch(1 0 0); color-scheme: light; }
    html.dark { background-color: #0a0a0a; background-color: oklch(0.145 0 0); color-scheme: dark; }
  </style>

  <!-- Build provenance (ENG-7096). `stampCommitShaPlugin` in vite.config.ts
       rewrites this content at build time with the commit Vercel built from
       (VERCEL_GIT_COMMIT_SHA). A local `bun run dev`/`bun run build` has no
       such variable, so it keeps the literal "dev" below — never a broken
       placeholder. The deployed-dev nightly curls this document and reports
       the value, so every run names the frontend that produced it. Renaming
       or reformatting this tag fails the build and the nightly's preflight. -->
  <meta name="pioneer-commit-sha" content="a32c94b8678aecb81bbfe3b003619880bed45b86" />

  <!-- Google Tag Manager, GA4 and Google Ads are loaded by
       src/lib/marketing-tags.ts on production hosts only, so previews, dev,
       staging and localhost never reach the production ad accounts. Do not
       add them back here. The GTM <noscript> iframe stays omitted: it points
       at googletagmanager.com, which is not in the frame-src CSP. -->

  <title>Fastino Labs</title>
  <meta name="description" content="Fastino AI — Fine-tune, evaluate, and deploy small language models and LLMs. OpenAI and Anthropic-compatible API. Full docs at https://docs.fastino.ai/llms.txt" />
